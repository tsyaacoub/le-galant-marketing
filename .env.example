# Anthropic (Console > API keys)
ANTHROPIC_API_KEY=

# Where rows live: "sheet" (Google Sheets) or "local" (data/*.json, for trying it out)
STORE=local

# Google Sheets. Share the sheet with the service account's email as Editor.
SHEET_ID=
# The full service-account JSON, base64-encoded: base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Meta. Long-lived token from Business Suite with instagram_basic,
# instagram_content_publish and instagram_manage_insights.
META_ACCESS_TOKEN=
# The Instagram Business account id (not the username). Graph API Explorer: me/accounts -> instagram_business_account
IG_USER_ID=

# Publisher safety switch. Anything but "yes" logs what it would post and stops.
PUBLISH_ENABLED=no
